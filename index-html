<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Burak Ali Karacan</title>
<meta name="theme-color" content="#080e19">

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
               Roboto, Arial, sans-serif;

  background:
    radial-gradient(circle at top right, #263653 0%, transparent 36%),
    radial-gradient(circle at bottom left, #17243a 0%, transparent 42%),
    #080e19;

  color: #fff;

  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  width: 100%;
  max-width: 430px;
}

.card {
  overflow: hidden;
  background: rgba(20, 29, 45, 0.97);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 30px;

  box-shadow:
    0 30px 80px rgba(0,0,0,.45),
    inset 0 1px 0 rgba(255,255,255,.05);
}

.header {
  text-align: center;
  padding: 35px 25px 28px;
}

.logo {
  width: 76px;
  height: 76px;
  margin: 0 auto 17px;
  border-radius: 22px;

  background: linear-gradient(145deg, #d8b35a, #a77b22);

  color: #101722;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 27px;
  font-weight: 900;

  box-shadow: 0 10px 30px rgba(216,179,90,.18);
}

.header h1 {
  margin: 0;
  font-size: 25px;
  font-weight: 750;
}

.header p {
  margin: 8px 0 0;
  color: #9ca8ba;
  font-size: 14px;
}

.divider {
  height: 1px;
  margin: 0 22px;
  background: rgba(255,255,255,.08);
}

.content {
  padding: 25px 20px 27px;
}

.welcome h2 {
  margin: 0;
  font-size: 18px;
}

.welcome p {
  margin: 7px 0 20px;
  color: #8995a8;
  font-size: 13px;
  line-height: 1.5;
}

.option {
  width: 100%;
  min-height: 80px;

  margin-top: 12px;
  padding: 15px;

  display: flex;
  align-items: center;

  border-radius: 20px;
  border: 1px solid rgba(255,255,255,.08);

  background: rgba(255,255,255,.045);

  color: #fff;
  text-decoration: none;

  cursor: pointer;
  font-family: inherit;
  text-align: left;

  transition: transform .18s ease, background .18s ease;
}

.option:hover {
  background: rgba(255,255,255,.075);
  transform: translateY(-2px);
}

.option:active {
  transform: scale(.98);
}

.icon {
  width: 50px;
  height: 50px;
  flex-shrink: 0;
  margin-right: 14px;

  border-radius: 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 22px;
}

.payment-icon {
  background: rgba(216,179,90,.14);
}

.review-icon {
  background: rgba(255,255,255,.08);
}

.option-info {
  flex: 1;
  text-align: left;
}

.option-title {
  font-size: 16px;
  font-weight: 750;
}

.option-description {
  margin-top: 5px;
  color: #8793a5;
  font-size: 12px;
  line-height: 1.4;
}

.arrow {
  margin-left: 8px;
  color: #78859a;
  font-size: 23px;
}

#paymentPanel {
  display: none;
  margin-top: 20px;
}

.iban-box {
  padding: 21px 14px;

  background: #0c1422;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 19px;

  text-align: center;
}

.iban-label {
  display: block;
  margin-bottom: 10px;

  color: #8490a3;

  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.iban {
  color: #fff;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.7;
  word-break: break-word;
}

.copy-button {
  width: 100%;

  margin-top: 12px;
  padding: 16px;

  border: 0;
  border-radius: 17px;

  background: linear-gradient(135deg, #d8b35a, #a77b22);

  color: #101722;

  font-size: 15px;
  font-weight: 800;

  cursor: pointer;
}

#message {
  min-height: 20px;
  margin-top: 9px;

  text-align: center;

  color: #73d39a;

  font-size: 12px;
  font-weight: 600;
}

.back-button {
  width: 100%;

  margin-top: 3px;
  padding: 13px;

  border: 0;
  background: transparent;

  color: #8995a8;

  font-size: 14px;
  cursor: pointer;
}

.footer {
  margin-top: 24px;
  text-align: center;
  color: #596579;
  font-size: 11px;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;

  background: #65d38b;
  box-shadow: 0 0 10px #65d38b;
}
</style>
</head>

<body>

<div class="container">
<div class="card">

  <div class="header">

    <div class="logo">BA</div>

    <h1>Burak Ali Karacan</h1>

    <p>Bilgi ve ödeme merkezi</p>

  </div>

  <div class="divider"></div>

  <div class="content">

    <div class="welcome">

      <h2>Hoş Geldiniz</h2>

      <p>
        Yapmak istediğiniz işlemi
        aşağıdaki seçeneklerden seçebilirsiniz.
      </p>

    </div>


    <!-- PARA GÖNDER -->

    <button
      type="button"
      class="option"
      onclick="showPayment()">

      <div class="icon payment-icon">
        💳
      </div>

      <div class="option-info">

        <div class="option-title">
          Para Gönder
        </div>

        <div class="option-description">
          Banka hesap bilgilerini görüntüle
        </div>

      </div>

      <div class="arrow">›</div>

    </button>


    <!-- BİZİ DEĞERLENDİR -->

    <a
      class="option"
      href="https://search.google.com/local/writereview?placeid=ChIJ1aH7qog4yxQRv6XSQaAsgB8">

      <div class="icon review-icon">
        ⭐
      </div>

      <div class="option-info">

        <div class="option-title">
          Bizi Değerlendir
        </div>

        <div class="option-description">
          Karacan Oto Elektrik için Google'da yorum bırak
        </div>

      </div>

      <div class="arrow">›</div>

    </a>


    <!-- IBAN -->

    <div id="paymentPanel">

      <div class="iban-box">

        <span class="iban-label">
          Ziraat Bankası · IBAN
        </span>

        <div class="iban">
          TR77 0001 0090 1108 1173 6050 01
        </div>

      </div>

      <button
        type="button"
        class="copy-button"
        onclick="copyIBAN()">

        IBAN'ı Kopyala

      </button>

      <div id="message"></div>

      <button
        type="button"
        class="back-button"
        onclick="hidePayment()">

        ← Ana Menüye Dön

      </button>

    </div>


    <div class="footer">

      <span class="status">
        <span class="status-dot"></span>
        Güvenli bilgi sayfası
      </span>

    </div>

  </div>

</div>
</div>


<script>

function showPayment() {

  const panel =
    document.getElementById("paymentPanel");

  panel.style.display = "block";

  panel.scrollIntoView({
    behavior: "smooth",
    block: "nearest"
  });
}


function hidePayment() {

  document.getElementById("paymentPanel")
    .style.display = "none";

  document.getElementById("message")
    .textContent = "";
}


function copyIBAN() {

  const iban =
    "TR770001009011081173605001";

  if (navigator.clipboard && window.isSecureContext) {

    navigator.clipboard.writeText(iban)
      .then(function() {

        document.getElementById("message")
          .textContent =
          "✓ IBAN başarıyla kopyalandı";

      })
      .catch(function() {

        fallbackCopy(iban);

      });

  } else {

    fallbackCopy(iban);

  }
}


function fallbackCopy(text) {

  const input =
    document.createElement("input");

  input.value = text;

  document.body.appendChild(input);

  input.select();

  try {

    document.execCommand("copy");

    document.getElementById("message")
      .textContent =
      "✓ IBAN başarıyla kopyalandı";

  } catch (error) {

    document.getElementById("message")
      .textContent =
      "IBAN'ı manuel olarak kopyalayabilirsiniz.";

  }

  document.body.removeChild(input);
}

</script>

</body>
</html>
